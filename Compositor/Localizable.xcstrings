    "Output black": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出黑场"
          }
        }
      }
    },
    "Output white": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出白场"
          }
        }
      }
    },
    "Instagram Square": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram 方形"
          }
        }
      }
    },
    "Instagram Portrait": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram 竖图"
          }
        }
      }
    },
    "Instagram Story": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram 快拍"
          }
        }
      }
    },
    "YouTube Thumb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 缩略图"
          }
        }
      }
    },
    "Resolution: 72 for screens, 300 for print. Click to switch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分辨率：屏幕用 72，印刷用 300。点击切换。"
          }
        }
      }
    },
    "Units: pixels, inches, centimeters or millimeters. Click to switch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单位：像素、英寸、厘米或毫米。点击切换。"
          }
        }
      }
    },
    "%@ uncompressed RGBA canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未压缩 RGBA 画布"
          }
        }
      }
    },
    "New: %lld × %lld pixels · %@ uncompressed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建：%lld × %lld 像素 · %@ 未压缩"
          }
        }
      }
    },
    "Final dimensions must be 1–%@ pixels per side.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终尺寸每边必须在 1–%@ 像素之间。"
          }
        }
      }
    },
    "A subdivision every %@ pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 %@ 像素一条细分线。"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动以提亮或压暗这些色调。沿底部拖动分隔线，可改变每个区域覆盖的色调。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点。点击添加，双击删除。"
          }
        }
      }
    },
    "Lifts or lowers the brightest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗最亮的色调。"
          }
        }
      }
    },
    "Lifts or lowers the light tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗较亮的色调。"
          }
        }
      }
    },
    "Lifts or lowers the dark tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗较暗的色调。"
          }
        }
      }
    },
    "Lifts or lowers the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗最暗的色调。"
          }
        }
      }
    },
    "How much the curve also changes color strength. Zero matches Photoshop; lower keeps it to brightness, higher adds more color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线同时改变色彩强度的程度。零与 Photoshop 一致；更低只影响亮度，更高会增加更多色彩。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面上拖动，调整指针下色调对应的曲线。"
          }
        }
      }
    },
    "Shifts the selected color family around the wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿色轮移动所选色系。"
          }
        }
      }
    },
    "Makes the selected color family stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱所选色系。"
          }
        }
      }
    },
    "Makes the selected color family lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选色系更亮或更暗。"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿色轮移动所选颜色。"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱所选颜色。"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色更亮或更暗。"
          }
        }
      }
    },
    "How far in hue the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在色相上影响的范围。"
          }
        }
      }
    },
    "How far in saturation the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在饱和度上影响的范围。"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在亮度上影响的范围。"
          }
        }
      }
    },
    "Shifts the wheels toward shadows or highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把色轮偏向阴影或高光。"
          }
        }
      }
    },
    "Straightens vertical lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把垂直线条向中心拉直。"
          }
        }
      }
    },
    "Straightens horizontal lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把水平线条向中心拉直。"
          }
        }
      }
    },
    "Rotates the picture around its center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕中心旋转画面。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对高度拉伸宽度。"
          }
        }
      }
    },
    "Zooms the transformed picture within the frame.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面内缩放变换后的图像。"
          }
        }
      }
    },
    "Moves the picture left or right.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移动画面。"
          }
        }
      }
    },
    "Moves the picture up or down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下移动画面。"
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变红色的解读方式。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱红色原色。"
          }
        }
      }
    },
    "Shifts how green is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变绿色的解读方式。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱绿色原色。"
          }
        }
      }
    },
    "Shifts how blue is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变蓝色的解读方式。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱蓝色原色。"
          }
        }
      }
    },
    "Tones from black on the left to white on the right: blacks, shadows, midtones, highlights, whites. Control-click to show the vectorscope.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左到右由黑到白：黑色、阴影、中间调、高光、白色。按住 Control 点击可显示矢量示波器。"
          }
        }
      }
    },
    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相绕色轮分布，饱和度从中心向外。按住 Control 点击可显示直方图。"
          }
        }
      }
    },
    "RGB histogram": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 直方图"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加大或减小明暗差别，主要作用于中间调。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最亮点。按住 Option 查看剪切的高光。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最暗点。按住 Option 查看剪切的阴影。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把画面从蓝色调向黄色。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把画面从绿色调向洋红色。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对较淡的颜色加强得更多，并保护肤色。"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同幅度加强或减弱所有颜色。"
          }
        }
      }
    },
    "Spreads a glow from the bright areas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从亮部散出辉光。"
          }
        }
      }
    },
    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置辉光扩散的距离。辉光未提高时不起作用。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把辉光从冷色调向暖色。光晕保持红色。辉光未提高时不起作用。"
          }
        }
      }
    },
    "Darkens or lightens the edges. The center does not change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗或提亮边缘。中心不变。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置晕影从中心向外开始的位置。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使晕影更圆或更方。"
          }
        }
      }
    },
    "Softens the edge of the vignette.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化晕影边缘。"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用暗角晕影时保护亮部像素。高光优先会用到。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更粗或更细。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更平滑或更不均匀。"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化从每条边缘向外影响的距离，单位为像素。"
          }
        }
      }
    },
    "Emphasizes fine texture over broader edges.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调细微纹理，而不是较宽的边缘。"
          }
        }
      }
    },
    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把锐化限制在较强的边缘。按住 Option 查看蒙版。"
          }
        }
      }
    },
    "Smooths grain and noise in brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑亮度中的颗粒和杂色。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少明亮度杂色时保留细微纹理。"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮度平滑后保留局部对比度。"
          }
        }
      }
    },
    "Smooths colored speckles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑彩色斑点。"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少颜色杂色时保留彩色边缘。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颜色平滑更柔或更紧。"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用多少配置文件的畸变校正。"
          }
        }
      }
    },
    "How much of the profile vignetting correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用多少配置文件的晕影校正。"
          }
        }
      }
    },
    "Straightens barrel or pincushion bending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正桶形或枕形弯曲。"
          }
        }
      }
    },
    "Weakens purple fringes inside the purple hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱紫色色相范围内的紫色边缘。"
          }
        }
      }
    },
    "Hue range where purple defringe runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫色去边所作用的色相范围。"
          }
        }
      }
    },
    "Weakens green fringes inside the green hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱绿色色相范围内的绿色边缘。"
          }
        }
      }
    },
    "Hue range where green defringe runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿色去边所作用的色相范围。"
          }
        }
      }
    },
    "Moves the vignette correction inward or outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把晕影校正向内或向外移动。"
          }
        }
      }
    },
    "Purple": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫色"
          }
        }
      }
    }
  },
  "version": "1.0"
}
